{
  "name": "gitlab-desk",
  "productName": "GitLab Desk",
  "version": "0.1.0",
  "description": "Client desktop non ufficiale per GitLab: modifiche, commit, branch e merge request.",
  "author": "GitLab Desk contributors",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.gitlabdesk.desktop",
    "productName": "GitLab Desk",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "LICENSE"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
